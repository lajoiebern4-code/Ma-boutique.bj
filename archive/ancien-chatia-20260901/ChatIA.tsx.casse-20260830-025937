import { useState } from 'react'\nimport { Bot, MessageCircle, Send, X, Loader2 } from 'lucide-react'\nimport { supabase } from '../lib/supabase'\n\ntype Message = {\n  role: 'user' | 'assistant'\n  content: string\n}\n\nexport default function ChatIA() {\n  const [ouvert, setOuvert] = useState(false)\n  const [message, setMessage] = useState('')\n  const [messages, setMessages] = useState<Message[]>([])\n  const [chargement, setChargement] = useState(false)\n  const [conversationId, setConversationId] = useState<string | null>(null)\n  const [conversationToken, setConversationToken] = useState<string | null>(null)\n\n  const envoyerMessage = async () => {\n    const texte = message.trim()\n\n    if (!texte || chargement) return\n\n    setMessage('')\n    setMessages((precedentes) => [\n      ...precedentes,\n      { role: 'user', content: texte },\n    ])\n    setChargement(true)\n\n    try {\n      const historique = [\n        ...messages,\n        { role: 'user' as const, content: texte },\n      ]\n\n      const { data, error } = await supabase.functions.invoke('assistant-ia', {\n        body: {\n          message: texte,\n          messages: historique,\n          conversation_id: conversationId,\n          conversation_token: conversationToken,\n        },\n      })\n\n        if (error) {\n          console.error('ChatIA - erreur Edge Function:', error)\n          console.error('ChatIA - data:', data)\n          throw new Error(\n            data?.error ||\n            error.message ||\n            'Erreur de communication avec le service IA'\n          )\n        }\n\n      if (!data?.answer) {\n        throw new Error('Réponse IA vide')\n      }\n\n\n        if (data?.conversation_id) {\n          setConversationId(data.conversation_id)\n        }\n\n        if (data?.conversation_token) {\n          setConversationToken(data.conversation_token)\n        }\n      setMessages((precedentes) => [\n        ...precedentes,\n        { role: 'assistant', content: data.answer },\n      ])\n    } catch (error) {\n      console.error('Chat IA:', error)\n\n      setMessages((precedentes) => [\n        ...precedentes,\n        {\n          role: 'assistant',\n          content:\n            "Désolé, je rencontre actuellement un problème. Réessayez dans quelques instants.",\n        },\n      ])\n    } finally {\n      setChargement(false)\n    }\n  }\n\n  const gererTouche = (event: React.KeyboardEvent<HTMLInputElement>) => {\n    if (event.key === 'Enter') {\n      event.preventDefault()\n      envoyerMessage()\n    }\n  }\n\n  return (\n    <>\n      {ouvert && (\n        <div className="fixed bottom-24 right-4 z-[9990] flex h-[min(600px,calc(100vh-120px))] w-[min(380px,calc(100vw-32px))] flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl dark:border-slate-800 dark:bg-slate-950">\n          <div className="flex items-center justify-between bg-slate-950 px-5 py-4 text-white">\n            <div className="flex items-center gap-3">\n              <div className="flex h-10 w-10 items-center justify-center rounded-2xl bg-orange-500">\n                <Bot size={22} />\n              </div>\n\n              <div>\n                <p className="font-semibold">Assistant ChinaShop</p>\n                <p className="text-xs text-slate-300">Disponible pour vous aider</p>\n              </div>\n            </div>\n\n            <button\n              type="button"\n              onClick={() => setOuvert(false)}\n              className="rounded-xl p-2 transition hover:bg-white/10"\n              aria-label="Fermer le chat"\n            >\n              <X size={20} />\n            </button>\n          </div>\n\n          <div className="flex-1 space-y-3 overflow-y-auto bg-slate-50 p-4 dark:bg-slate-900">\n            {messages.length === 0 && (\n              <div className="flex h-full flex-col items-center justify-center px-6 text-center">\n                <div className="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text-orange-600 dark:bg-orange-500/10">\n                  <Bot size={28} />\n                </div>\n\n                <h3 className="font-semibold text-slate-900 dark:text-white">\n                  Bonjour 👋\n                </h3>\n\n                <p className="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">\n                  Je suis l'assistant ChinaShop-Bénin. Comment puis-je vous aider ?\n                </p>\n              </div>\n            )}\n\n            {messages.map((item, index) => (\n              <div\n                key={`${item.role}-${index}`}\n                className={`flex ${\n                  item.role === 'user' ? 'justify-end' : 'justify-start'\n                }`}\n              >\n                <div\n                  className={`max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-6 ${\n                    item.role === 'user'\n                      ? 'rounded-br-md bg-orange-500 text-white'\n                      : 'rounded-bl-md bg-white text-slate-700 shadow-sm dark:bg-slate-800 dark:text-slate-200'\n                  }`}\n                >\n                  {item.content}\n                </div>\n              </div>\n            ))}\n\n            {chargement && (\n              <div className="flex justify-start">\n                <div className="flex items-center gap-2 rounded-2xl rounded-bl-md bg-white px-4 py-3 text-sm text-slate-500 shadow-sm dark:bg-slate-800 dark:text-slate-400">\n                  <Loader2 size={16} className="animate-spin" />\n                  L'assistant réfléchit...\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className="border-t border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-950">\n            <div className="flex items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-2 focus-within:border-orange-400 dark:border-slate-700 dark:bg-slate-900">\n              <input\n                type="text"\n                value={message}\n                onChange={(event) => setMessage(event.target.value)}\n                onKeyDown={gererTouche}\n                placeholder="Écrivez votre message..."\n                disabled={chargement}\n                className="min-w-0 flex-1 bg-transparent px-2 py-2 text-sm text-slate-900 outline-none placeholder:text-slate-400 dark:text-white"\n              />\n\n              <button\n                type="button"\n                onClick={envoyerMessage}\n                disabled={!message.trim() || chargement}\n                className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-500 text-white transition hover:bg-orange-600 disabled:cursor-not-allowed disabled:opacity-40"\n                aria-label="Envoyer"\n              >\n                <Send size={18} />\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      <button\n        type="button"\n        onClick={() => setOuvert((valeur) => !valeur)}\n        className="fixed bottom-5 right-5 z-[9991] flex h-14 w-14 items-center justify-center rounded-full bg-orange-500 text-white shadow-xl transition hover:scale-105 hover:bg-orange-600 active:scale-95"\n        aria-label={ouvert ? 'Fermer le chat IA' : 'Ouvrir le chat IA'}\n      >\n        {ouvert ? <X size={24} /> : <MessageCircle size={25} />}\n      </button>\n    </>\n  )\n}\n