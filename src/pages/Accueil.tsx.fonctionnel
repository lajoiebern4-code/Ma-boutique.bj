import { useEffect, useState, useRef } from 'react'
import { Link } from 'react-router-dom'
import { motion, useInView } from 'framer-motion'
import {
  ArrowRight, Package, ShoppingBag, Truck, ShieldCheck, Clock,
  Star, Users, Globe, Quote, BadgeCheck, Gift, Sparkles,
  Zap, Headphones, Gem, ThumbsUp, CheckCircle2, CircleDollarSign,
  ChevronRight, Crown, Award, Rocket, Flame, TrendingUp
} from 'lucide-react'
import { obtenirProduits, type Produit } from '../services/produits'
import { useCart } from '../context/CartContext'

function formatPrix(prix: number) {
  return `${Number(prix || 0).toLocaleString('fr-FR')} FCFA`
}

// ===== COMPTEUR ANIMÉ =====
function AnimatedCounter({ value, label, icon: Icon }) {
  const [count, setCount] = useState(0)
  const ref = useRef(null)
  const isInView = useInView(ref, { once: true })

  useEffect(() => {
    if (isInView) {
      const target = parseInt(value.replace('+', ''))
      let current = 0
      const timer = setInterval(() => {
        current += Math.ceil(target / 30)
        if (current >= target) {
          setCount(target)
          clearInterval(timer)
        } else {
          setCount(current)
        }
      }, 40)
      return () => clearInterval(timer)
    }
  }, [isInView, value])

  return (
    <div ref={ref} className="text-center">
      <Icon className="mx-auto h-8 w-8 text-[#FF7A1A]" />
      <p className="mt-2 text-4xl font-black text-white">{count}+</p>
      <p className="text-sm text-blue-200">{label}</p>
    </div>
  )
}

