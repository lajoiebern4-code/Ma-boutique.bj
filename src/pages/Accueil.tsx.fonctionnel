// ===== PRODUITS =====
function Products() {
  const { ajouter } = useCart()
  const [produits, setProduits] = useState<Produit[]>([])
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    let active = true
    async function load() {
      try {
        const data = await obtenirProduits()
        if (active) setProduits(data.slice(0, 8))
      } catch (e) { console.error(e) }
      finally { if (active) setLoading(false) }
    }
    load()
    return () => { active = false }
  }, [])

  return (
    <section className="bg-[#F8FAFC] py-16">
      <div className="mx-auto max-w-7xl px-4">
        <div className="flex items-center justify-between">
          <div>
            <span className="rounded-full bg-[#EBF5FF] px-4 py-1 text-xs font-bold uppercase text-[#0052CC]">Sélection</span>
            <h2 className="mt-2 text-3xl font-black text-[#0B1E3D]">Meilleurs <span className="text-[#0052CC]">produits</span></h2>
          </div>
          <Link to="/catalogue">
            <button className="rounded-xl border-2 border-[#0052CC] px-5 py-2 font-bold text-[#0052CC] transition hover:bg-[#0052CC] hover:text-white">
              Voir tout
            </button>
          </Link>
        </div>

        {loading ? (
          <div className="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
            {[...Array(4)].map((_, i) => <div key={i} className="h-72 animate-pulse rounded-2xl bg-gray-200" />)}
          </div>
        ) : (
          <div className="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
            {produits.map((p, idx) => (
              <motion.div
                key={p.id}
                initial={{ opacity: 0, y: 30 }}
                whileInView={{ opacity: 1, y: 0 }}
                transition={{ delay: idx * 0.05 }}
                whileHover={{ y: -8 }}
                className="overflow-hidden rounded-2xl bg-white shadow-sm transition hover:shadow-xl"
              >
                <Link to={`/produit/${p.id}`}>
                  <div className="relative aspect-square overflow-hidden bg-gray-100">
                    {p.image_url ? (
                      <img src={p.image_url} alt={p.nom} className="h-full w-full object-cover transition hover:scale-105" />
                    ) : (
                      <div className="flex h-full items-center justify-center text-gray-400">
                        <Package size={40} />
                      </div>
                    )}
                    {p.nouveau && <span className="absolute left-2 top-2 rounded-full bg-[#0052CC] px-2.5 py-1 text-xs font-bold text-white">Nouveau</span>}
                    {p.promo > 0 && <span className="absolute right-2 top-2 rounded-full bg-[#FF7A1A] px-2.5 py-1 text-xs font-bold text-white">-{p.promo}%</span>}
                  </div>
                </Link>
                <div className="p-3">
                  <p className="text-xs font-bold uppercase text-[#0052CC]">{p.categorie || 'Sélection'}</p>
                  <h3 className="mt-0.5 line-clamp-2 text-sm font-bold text-[#0B1E3D]">{p.nom}</h3>
                  <p className="mt-1 text-lg font-black text-[#0B1E3D]">{formatPrix(p.prix)}</p>
                  <button
                    onClick={() => ajouter({
                      id: p.id, nom: p.nom, prix: p.prix,
                      image_url: p.image_url || null, stock: p.stock,
                      surCommande: p.stock <= 0 && p.disponibilite === 'sur_commande'
                    })}
                    className="mt-2 flex w-full items-center justify-center gap-2 rounded-xl bg-[#0052CC] py-2 text-sm font-bold text-white transition hover:bg-[#003D99]"
                  >
                    <ShoppingBag size={16} /> Ajouter
                  </button>
                </div>
              </motion.div>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

