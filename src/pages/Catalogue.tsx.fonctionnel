import { useEffect, useMemo, useState } from 'react'
import { Link, useNavigate } from 'react-router-dom'
import {
  ArrowDownUp,
  Check,
  ChevronDown,
  Filter,
  Search,
  ShoppingCart,
  X,
  Megaphone,
  Truck,
  Package,
} from 'lucide-react'
import { obtenirProduits, type Produit } from '../services/produits'
import { useCart, type CartProduct } from '../context/CartContext'
import { CATEGORIES } from '../data/categories'

type Tri =
  | 'pertinence'
  | 'prix-croissant'
  | 'prix-decroissant'
  | 'nouveautes'

function formatPrix(prix: number) {
  return `${prix.toLocaleString('fr-FR')} FCFA`
}

function convertirProduitPanier(
  produit: Produit,
  surCommande: boolean,
): CartProduct {
  return {
    id: produit.id,
    nom: produit.nom,
    prix: produit.prix,
    image_url: produit.image_url || null,
    stock: produit.stock,
    surCommande,
  }
}

function CarteProduit({
  produit,
  onAjouter,
}: {
  produit: Produit
  onAjouter: (produit: CartProduct) => void
}) {
  const navigate = useNavigate()

  const enStock = produit.stock > 0
  const surCommande =
    produit.stock <= 0 && produit.disponibilite === 'sur_commande'
  const indisponible = !enStock && !surCommande

  const ajouterAuPanier = () => {
    if (indisponible) return
    onAjouter(convertirProduitPanier(produit, surCommande))
  }

  const commander = () => {
    if (indisponible) return
    ajouterAuPanier()
    navigate('/commande')
  }

  return (
    <article className="group overflow-hidden rounded-[1.35rem] border border-slate-200/80 bg-white shadow-[0_4px_20px_rgba(11,30,61,0.04)] transition duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-[0_18px_45px_rgba(11,30,61,0.10)]">
      <Link
        to={`/produit/${produit.id}`}
        className="block"
        aria-label={`Voir ${produit.nom}`}
      >
        <div className="relative aspect-square overflow-hidden bg-slate-100">
          {produit.image_url ? (
            <img
              src={produit.image_url}
              alt={produit.nom}
              className="h-full w-full object-cover transition duration-500 group-hover:scale-[1.045]"
              loading="lazy"
            />
          ) : (
            <div className="flex h-full items-center justify-center text-xs font-semibold text-slate-400">
              Image non disponible
            </div>
          )}

          <div className="absolute inset-x-3 top-3 flex items-start justify-between gap-2">
            <div className="flex flex-wrap gap-1.5">
              {produit.nouveau && (
                <span className="rounded-full bg-[#0284C7] px-2.5 py-1 text-[10px] font-black uppercase tracking-wide text-white shadow-sm">
                  Nouveau
                </span>
              )}

              {produit.promo > 0 && (
                <span className="rounded-full bg-orange-500 px-2.5 py-1 text-[10px] font-black text-white shadow-sm">
                  -{produit.promo}%
                </span>
              )}
            </div>

            {enStock && (
              <span className="rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-black text-emerald-700 shadow-sm backdrop-blur">
                Disponible
              </span>
            )}
          </div>
        </div>
      </Link>

      <div className="p-4 sm:p-5">
        <div className="flex items-center justify-between gap-2">
          <p className="truncate text-[10px] font-black uppercase tracking-[0.14em] text-orange-600">
            {produit.categorie || 'Sélection ChinaShop-Bénin'}
          </p>

          {produit.promo > 0 && (
            <span className="shrink-0 text-[10px] font-bold text-orange-600">
              Offre
            </span>
          )}
        </div>

        <Link to={`/produit/${produit.id}`}>
          <h2 className="mt-1.5 line-clamp-2 min-h-11 text-sm font-extrabold leading-5 text-[#0B1E3D] transition-colors group-hover:text-orange-600 sm:text-[15px]">
            {produit.nom}
          </h2>
        </Link>

        <div className="mt-3">
          <p className="text-[17px] font-black tracking-tight text-[#0B1E3D]">
            {formatPrix(produit.prix)}
          </p>

          {produit.prixOriginal &&
            produit.prixOriginal > produit.prix && (
              <p className="mt-0.5 text-xs font-medium text-slate-400 line-through">
                {formatPrix(produit.prixOriginal)}
              </p>
            )}
        </div>

        <div className="mt-4 flex items-center gap-2">
          <span
            className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-[10px] font-extrabold ${
              enStock
                ? 'bg-emerald-50 text-emerald-700'
                : surCommande
                  ? 'bg-blue-50 text-blue-700'
                  : 'bg-slate-100 text-slate-500'
            }`}
          >
            <span
              className={`h-1.5 w-1.5 rounded-full ${
                enStock
                  ? 'bg-emerald-500'
                  : surCommande
                    ? 'bg-blue-500'
                    : 'bg-slate-400'
              }`}
            />
            {enStock
              ? 'En stock'
              : surCommande
                ? 'Disponible sur commande'
                : 'Indisponible'}
          </span>
        </div>

        <div className="mt-4 grid grid-cols-2 gap-2">
          <button
            type="button"
            disabled={indisponible}
            onClick={ajouterAuPanier}
            className="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-xl border border-[#0B1E3D] bg-white px-2 text-[11px] font-black text-[#0B1E3D] transition hover:bg-[#0284C7] hover:text-white disabled:cursor-not-allowed disabled:border-slate-200 disabled:bg-slate-100 disabled:text-slate-400"
          >
            <ShoppingCart size={15} />
            Ajouter
          </button>

          <button
            type="button"
            disabled={indisponible}
            onClick={commander}
            className="inline-flex min-h-11 items-center justify-center rounded-xl bg-[#0284C7] px-2 text-[11px] font-black text-white transition hover:bg-[#0369A1] disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400"
          >
            Commander
          </button>
        </div>
      </div>
    </article>
  )
}

function SkeletonCarte() {
  return (
    <div className="overflow-hidden rounded-[1.35rem] border border-slate-200/70 bg-white">
      <div className="aspect-square animate-pulse bg-slate-200" />
      <div className="space-y-3 p-4 sm:p-5">
        <div className="h-2.5 w-20 animate-pulse rounded-full bg-slate-200" />
        <div className="h-4 w-4/5 animate-pulse rounded bg-slate-200" />
        <div className="h-4 w-3/5 animate-pulse rounded bg-slate-200" />
        <div className="h-5 w-28 animate-pulse rounded bg-slate-200" />
        <div className="h-10 animate-pulse rounded-xl bg-slate-200" />
      </div>
    </div>
  )
}

export default function Catalogue() {
  const { ajouter } = useCart()

  const [produits, setProduits] = useState<Produit[]>([])
  const [chargement, setChargement] = useState(true)
  const [recherche, setRecherche] = useState('')
  const [categorie, setCategorie] = useState('tous')
  const [sousCategorie, setSousCategorie] = useState('tous')
  const [disponibilite, setDisponibilite] = useState('tous')
  const [tri, setTri] = useState<Tri>('pertinence')
  const [filtresOuverts, setFiltresOuverts] = useState(false)

  useEffect(() => {
    let actif = true

    async function charger() {
      try {
        const resultat = await Promise.race([
          obtenirProduits(),
          new Promise<Produit[]>((_, reject) =>
            setTimeout(
              () => reject(new Error('TIMEOUT SUPABASE 10s')),
              10000,
            ),
          ),
        ])

        if (actif) {
          setProduits(resultat)
        }
      } catch (err) {
        console.error(
          'Erreur chargement catalogue:',
          err instanceof Error ? err.message : String(err),
        )
      } finally {
        if (actif) {
          setChargement(false)
        }
      }
    }

    charger()

    return () => {
      actif = false
    }
  }, [])

  const categorieActive = CATEGORIES.find(
    (item) => item.id === categorie,
  )

  const produitsVisibles = useMemo(() => {
    return produits.filter(
      (produit) =>
        produit.stock > 0 ||
        produit.disponibilite === 'sur_commande',
    )
  }, [produits])

  const produitsFiltres = useMemo(() => {
    const terme = recherche.trim().toLowerCase()

    const resultat = produitsVisibles.filter((produit) => {
      const correspondRecherche =
        !terme ||
        produit.nom.toLowerCase().includes(terme) ||
        produit.description?.toLowerCase().includes(terme) ||
        produit.categorie?.toLowerCase().includes(terme) ||
        produit.sous_categorie?.toLowerCase().includes(terme)

      const correspondCategorie =
        categorie === 'tous' || produit.categorie === categorie

      const correspondSousCategorie =
        sousCategorie === 'tous' ||
        produit.sous_categorie === sousCategorie

      const correspondDisponibilite =
        disponibilite === 'tous' ||
        (disponibilite === 'disponible' && produit.stock > 0) ||
        (disponibilite === 'sur_commande' &&
          produit.disponibilite === 'sur_commande')

      return (
        correspondRecherche &&
        correspondCategorie &&
        correspondSousCategorie &&
        correspondDisponibilite
      )
    })

    return [...resultat].sort((a, b) => {
      if (tri === 'prix-croissant') {
        return a.prix - b.prix
      }

      if (tri === 'prix-decroissant') {
        return b.prix - a.prix
      }

      if (tri === 'nouveautes') {
        return Number(b.nouveau) - Number(a.nouveau)
      }

      return 0
    })
  }, [
    produitsVisibles,
    recherche,
    categorie,
    sousCategorie,
    disponibilite,
    tri,
  ])

  const nombreFiltresActifs = [
    categorie !== 'tous',
    sousCategorie !== 'tous',
    disponibilite !== 'tous',
    recherche.trim() !== '',
  ].filter(Boolean).length

  function changerCategorie(value: string) {
    setCategorie(value)
    setSousCategorie('tous')
  }

  function reinitialiserFiltres() {
    setRecherche('')
    setCategorie('tous')
    setSousCategorie('tous')
    setDisponibilite('tous')
    setTri('pertinence')
  }

  return (
    <div className="min-h-[70vh] bg-[#F7F5F1]">
      <section className="border-b border-slate-200/80 bg-[#F7F5F1]">
        <div className="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
          <div className="max-w-3xl">
            <p className="text-[10px] font-black uppercase tracking-[0.18em] text-orange-600">
              Catalogue ChinaShop-Benin
            </p>

            <h1 className="mt-2 text-3xl font-black tracking-[-0.035em] text-[#0B1E3D] sm:text-4xl">
              Trouvez simplement ce que vous recherchez.
            </h1>

            <p className="mt-3 max-w-2xl text-sm leading-6 text-slate-500 sm:text-[15px]">
              Découvrez nos produits disponibles au Bénin ou proposés sur commande
              depuis la Chine.
            </p>
          </div>
        </div>
      </section>

      <main className="mx-auto max-w-7xl px-4 py-7 sm:px-6 sm:py-10 lg:px-8">
        <section className="rounded-2xl border border-slate-200/80 bg-white p-3.5 shadow-[0_6px_24px_rgba(11,30,61,0.045)] sm:p-4">
          <div className="flex flex-col gap-3 lg:flex-row lg:items-center">
            <div className="relative flex-1">
              <Search
                size={19} strokeWidth={2.2}
                className="absolute left-4 top-1/2 -translate-y-1/2 text-[#0284C7]"
              />

              <input
                value={recherche}
                onChange={(event) => setRecherche(event.target.value)}
                placeholder="Que recherchez-vous ?"
                aria-label="Rechercher un produit"
                className="h-12 w-full rounded-xl border border-slate-200 bg-slate-50 pl-12 pr-12 text-sm font-semibold text-[#0B1E3D] outline-none transition duration-200 placeholder:text-slate-400 hover:border-slate-300 hover:bg-white focus:border-[#0284C7] focus:bg-white focus:ring-4 focus:ring-[#0284C7]/10"
              />

              {recherche && (
                <button
                  type="button"
                  onClick={() => setRecherche('')}
                  className="absolute right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                  aria-label="Effacer la recherche"
                >
                  <X size={16} />
                </button>
              )}
            </div>

            <div className="flex gap-2">
              <button
                type="button"
                onClick={() => setFiltresOuverts((ouvert) => !ouvert)}
                className={`relative inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl border px-4 text-sm font-black transition lg:hidden ${
                  filtresOuverts || nombreFiltresActifs > 0
                    ? 'border-orange-200 bg-orange-50 text-orange-700'
                    : 'border-slate-200 bg-white text-[#0B1E3D]'
                }`}
              >
                <Filter size={17} />
                Filtres
              </button>

              <details className="group relative flex-1 lg:flex-none">
              <summary
                className="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-[#0B1E3D] shadow-sm transition hover:border-orange-300 hover:shadow-md [&::-webkit-details-marker]:hidden"
                aria-label="Trier les produits"
              >
                <span className="flex items-center gap-2">
                  <ArrowDownUp size={16} className="text-slate-400" />
                  <span>
                    {tri === 'pertinence'
                      ? 'Pertinence'
                      : tri === 'nouveautes'
                        ? 'Nouveautés'
                        : tri === 'prix-croissant'
                          ? 'Prix croissant'
                          : 'Prix décroissant'}
                  </span>
                </span>

                <ChevronDown
                  size={16}
                  className="text-slate-400 transition-transform duration-200 group-open:rotate-180"
                />
              </summary>

              <div className="absolute right-0 z-30 mt-2 w-full min-w-[220px] overflow-hidden rounded-2xl border border-slate-200 bg-white p-1.5 shadow-[0_18px_45px_rgba(11,30,61,0.14)]">
                {[
                  ['pertinence', 'Pertinence'],
                  ['nouveautes', 'Nouveautés'],
                  ['prix-croissant', 'Prix croissant'],
                  ['prix-decroissant', 'Prix décroissant'],
                ].map(([value, label]) => (
                  <button
                    key={value}
                    type="button"
                    onClick={(event) => {
                      setTri(value as Tri)
                      event.currentTarget.closest('details')?.removeAttribute('open')
                    }}
                    className={`flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-bold transition ${
                      tri === value
                        ? 'bg-orange-50 text-orange-700'
                        : 'text-[#0B1E3D] hover:bg-slate-50'
                    }`}
                  >
                    <span>{label}</span>

                    {tri === value && (
                      <Check size={16} className="shrink-0 text-orange-500" />
                    )}
                  </button>
                ))}
              </div>
            </details>
            </div>
          </div>

          <div
            className={`${
              filtresOuverts ? 'block' : 'hidden'
            } mt-3 border-t border-slate-100 pt-4 lg:block`}
          >
            <div className="grid gap-3 md:grid-cols-3">
              <div className="block">
                <span className="mb-2 block text-[10px] font-black uppercase tracking-wider text-slate-500">
                  Catégorie
                </span>

                <div className="flex gap-2 overflow-x-auto pb-1 scrollbar-none">
              {CATEGORIES.map((item) => {
                const actif = categorie === item.id

                return (
                  <button
                    key={item.id}
                    type="button"
                    onClick={() => changerCategorie(item.id)}
                    aria-pressed={actif}
                    className={`shrink-0 rounded-xl border px-4 py-2.5 text-sm font-bold transition-all duration-200 ${
                      actif
                        ? 'border-[#0284C7] bg-[#0284C7] text-white shadow-md shadow-blue-500/15'
                        : 'border-slate-200 bg-white text-[#0B1E3D] hover:border-[#0284C7]/40 hover:bg-blue-50'
                    }`}
                  >
                    {item.label}
                  </button>
                )
              })}
            </div>
              </div>

              <label className="block">
                <span className="mb-2 block text-[10px] font-black uppercase tracking-wider text-slate-500">
                  Sous-catégorie
                </span>

                <select
                  value={sousCategorie}
                  onChange={(event) =>
                    setSousCategorie(event.target.value)
                  }
                  disabled={!categorieActive?.sousCategories?.length}
                  className="h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-[#0B1E3D] outline-none transition focus:border-orange-400 disabled:bg-slate-50 disabled:text-slate-400"
                >
                  <option value="tous">Toutes les sous-catégories</option>

                  {categorieActive?.sousCategories?.map((item) => (
                    <option key={item.id} value={item.id}>
                      {item.label}
                    </option>
                  ))}
                </select>
              </label>

              <label className="block">
                <span className="mb-2 block text-[10px] font-black uppercase tracking-wider text-slate-500">
                  Disponibilité
                </span>

                <select
                  value={disponibilite}
                  onChange={(event) =>
                    setDisponibilite(event.target.value)
                  }
                  className="h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-[#0B1E3D] outline-none transition focus:border-orange-400 focus:ring-4 focus:ring-orange-500/10"
                >
                  <option value="tous">Toutes les disponibilités</option>
                  <option value="disponible">En stock</option>
                  <option value="sur_commande">Sur commande</option>
                </select>
              </label>
            </div>

            {nombreFiltresActifs > 0 && (
              <div className="mt-4 flex flex-wrap items-center gap-2">
                <span className="mr-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                  Filtres actifs
                </span>

                {recherche.trim() && (
                  <button
                    type="button"
                    onClick={() => setRecherche('')}
                    className="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-[10px] font-bold text-slate-700"
                  >
                    Recherche : {recherche.trim()}
                    <X size={12} />
                  </button>
                )}

                {categorie !== 'tous' && (
                  <button
                    type="button"
                    onClick={() => changerCategorie('tous')}
                    className="inline-flex items-center gap-1.5 rounded-full bg-orange-50 px-3 py-1.5 text-[10px] font-bold text-orange-700"
                  >
                    Catégorie
                    <X size={12} />
                  </button>
                )}

                {sousCategorie !== 'tous' && (
                  <button
                    type="button"
                    onClick={() => setSousCategorie('tous')}
                    className="inline-flex items-center gap-1.5 rounded-full bg-orange-50 px-3 py-1.5 text-[10px] font-bold text-orange-700"
                  >
                    Sous-catégorie
                    <X size={12} />
                  </button>
                )}

                {disponibilite !== 'tous' && (
                  <button
                    type="button"
                    onClick={() => setDisponibilite('tous')}
                    className="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1.5 text-[10px] font-bold text-blue-700"
                  >
                    Disponibilité
                    <X size={12} />
                  </button>
                )}

                <button
                  type="button"
                  onClick={reinitialiserFiltres}
                  className="ml-1 text-[10px] font-black text-[#0B1E3D] underline decoration-orange-400 decoration-2 underline-offset-2"
                >
                  Tout effacer
                </button>
              </div>
            )}
          </div>
        </section>

        <section className="mt-8">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p className="text-[10px] font-black uppercase tracking-[0.16em] text-orange-600">
                Notre sélection
              </p>

              <h2 className="mt-1 text-2xl font-black tracking-tight text-[#0B1E3D] sm:text-3xl">
                Produits disponibles
              </h2>

              <p className="mt-1.5 text-xs leading-5 text-slate-500 sm:text-sm">
                Des références disponibles au Bénin ou accessibles sur
                commande.
              </p>
            </div>


          </div>

          {chargement ? (
            <div className="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
              {Array.from({ length: 8 }).map((_, index) => (
                <SkeletonCarte key={index} />
              ))}
            </div>
          ) : produitsFiltres.length > 0 ? (
            <div className="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
              {produitsFiltres.map((produit) => (
                <CarteProduit
                  key={produit.id}
                  produit={produit}
                  onAjouter={ajouter}
                />
              ))}
            </div>
          ) : (
            <div className="mt-6 overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white px-5 py-14 text-center shadow-sm">
              <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
                <Search size={25} />
              </div>

              <h2 className="mt-5 text-lg font-black text-[#0B1E3D]">
                Aucun produit ne correspond à votre recherche
              </h2>

              <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                Essayez un autre terme, une autre catégorie ou
                réinitialisez vos filtres pour retrouver toute notre
                sélection.
              </p>

              <button
                type="button"
                onClick={reinitialiserFiltres}
                className="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-[#0284C7] px-5 text-sm font-black text-white transition hover:bg-[#0369A1]"
              >
                Afficher toute la sélection
              </button>
            </div>
          )}
        </section>

          {!chargement && produitsVisibles.length > 0 && (
            <section className="mt-8 rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm sm:px-5">
              <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p className="text-xs font-extrabold text-[#0B1E3D]">
                    Besoin d'informations avant de commander ?
                  </p>
                  <p className="mt-0.5 text-xs text-slate-500">
                    Consultez nos conditions de commande, livraison et retrait.
                  </p>
                </div>

                <Link
                  to="/infos"
                  className="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-[#0284C7] px-4 text-xs font-black text-[#0284C7] transition hover:bg-blue-50"
                >
                  Informations pratiques
                  <ChevronDown size={15} className="-rotate-90" />
                </Link>
              </div>
            </section>
          )}
      </main>
    </div>
  )
}
